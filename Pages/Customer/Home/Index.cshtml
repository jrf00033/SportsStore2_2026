@page
@model SportsStore2_2026.Pages.Customer.Home.IndexModel

<h1>Products</h1>

<div class="row">

	@foreach(var product in Model.ProductList) //defining a var and refering to index model
	{
	
		<div class="col-md-4 mb-1">
			<div class = "card">
				<img src="~/images/@product.Image" class="card-img-top" style="height:200px"/>

				<div class="card-body" >
					<h5 class="card-title">@product.Name</h5>
					<p class="card-text">
						@product.Description
						
						Price: $@product.Price
					</p>

					<a asp-page ="/Customer/Home/ProductDetailsForCustomer" asp-route-id="@product.ProductID"
					class="btn btn-primary">View Details</a>
				
				</div>

			</div>
		</div>

	}




</div>
